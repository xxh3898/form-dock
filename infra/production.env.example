# Production configuration key 예시다. 실제 credential을 이 파일에 넣지 않는다.
FORMDOCK_API_IMAGE=example.invalid/form-dock-api:sha-replace-with-exact-release-commit
FORMDOCK_WEB_IMAGE=example.invalid/form-dock-web:sha-replace-with-exact-release-commit
FORMDOCK_WEB_PORT=18082

FORMDOCK_DB_NAME=formdock
FORMDOCK_DB_USERNAME=formdock
FORMDOCK_DB_PASSWORD=replace-with-production-secret

# Initial Creator provisioning은 명시적으로 활성화할 때만 동작한다.
FORMDOCK_BOOTSTRAP_ENABLED=false
FORMDOCK_BOOTSTRAP_EMAIL=
FORMDOCK_BOOTSTRAP_PASSWORD=
FORMDOCK_BOOTSTRAP_DISPLAY_NAME=

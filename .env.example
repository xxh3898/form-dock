# Local development only. Never reuse these values in shared or production environments.
FORMDOCK_WEB_PORT=18082
FORMDOCK_API_PORT=18081
FORMDOCK_DB_PORT=15433
FORMDOCK_DB_NAME=formdock
FORMDOCK_DB_USERNAME=formdock
FORMDOCK_DB_PASSWORD=formdock-local-only

# Initial Creator provisioning is opt-in. Replace placeholders only in a Git-ignored local .env.
FORMDOCK_BOOTSTRAP_ENABLED=false
FORMDOCK_BOOTSTRAP_EMAIL=creator@example.test
FORMDOCK_BOOTSTRAP_PASSWORD=change-this-local-placeholder
FORMDOCK_BOOTSTRAP_DISPLAY_NAME=Local Creator
